  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "sass-embedded": "^1.104.0",
